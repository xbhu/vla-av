# ================================
data/raw/
data/processed/
*.csv
*.parquet
*.h5
*.hdf5
*.pcd
*.bin
*.bag

# Exception: keep README files in data/
!data/README.md
!data/raw/.gitkeep
!data/processed/.gitkeep

